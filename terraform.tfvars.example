# Copy this file to terraform.tfvars and customize with your values
# cp terraform.tfvars.example terraform.tfvars

# AWS Region
aws_region = "us-east-1"

# Environment name
environment = "dev"

# Project name (used for naming all resources)
project_name = "eks-app"

# ============================================
# VPC Configuration
# ============================================
vpc_cidr = "10.0.0.0/16"

# ============================================
# EKS Cluster Configuration
# ============================================
# Kubernetes version (1.27, 1.28, 1.29, 1.30, 1.31, 1.36, etc.)
cluster_version = "1.36"

# ============================================
# Node Group Configuration
# ============================================
# EC2 instance type for nodes
# Recommended: t3.medium (2 vCPU, 4GB RAM) for development
# Production: t3.large or larger
instance_type = "t3.medium"

# Capacity type: ON_DEMAND or SPOT
# Use ON_DEMAND for stability, SPOT for cost savings
capacity_type = "ON_DEMAND"

# Node scaling configuration
node_group_min_size     = 1
node_group_desired_size = 1
node_group_max_size     = 1

# ============================================
# Tags (Applied to all resources)
# ============================================
tags = {
  Terraform   = "true"
  Environment = "dev"
  Project     = "eks-app"
  ManagedBy   = "Terraform"
  Owner       = "DevOps-Team"
}

# ============================================
# Optional: To change region
# ============================================
# aws_region = "us-west-2"

# ============================================
# Optional: For production
# ============================================
# environment = "prod"
# cluster_version = "1.36"
# instance_type = "t3.micro"
# node_group_min_size = 2
# node_group_desired_size = 3
# node_group_max_size = 5
